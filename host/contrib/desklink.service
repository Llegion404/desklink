[Unit]
Description=DeskLink remote desktop host (KDE Wayland)
# Needs the user's graphical session for the portal + PipeWire.
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
# The portal shows a consent dialog on every start (XDG policy for
# remote-desktop sessions); this unit just restarts if it is denied.
WorkingDirectory=%h/personal/desklink/host
ExecStart=/usr/bin/env python3 -m desklink serve
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
