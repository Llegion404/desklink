[Desktop Entry]
Type=Application
Name=DeskLink Viewer
GenericName=Remote Desktop Client
Comment=Control a DeskLink host (KDE Plasma Wayland) from this desktop
Exec=python3 -m desklink view
Path=%h/desklink/host
Terminal=false
Icon=video-display
Categories=Network;RemoteAccess;
Keywords=remote;desktop;desklink;vnc;rdp;
StartupNotify=true
